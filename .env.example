# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Вход: один общий пароль. APP_SECRET — любая длинная случайная строка для подписи сессии.
APP_PASSWORD=
APP_SECRET=

# Claude API — автотеги, советы, капсула (необязательно)
ANTHROPIC_API_KEY=
